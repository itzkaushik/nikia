{
  "name": "nikia",
  "version": "1.0.2",
  "description": "Nikia — Watch Together Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "node obfuscate.js && electron-builder --win -p always && node restore.js",
    "build:mac": "node obfuscate.js && electron-builder --mac -p always && node restore.js",
    "build": "node obfuscate.js && electron-builder --win --mac -p always && node restore.js"
  },
  "author": "itzkaushik",
  "license": "MIT",
  "devDependencies": {
    "cheerio": "^1.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "javascript-obfuscator": "^5.5.0"
  },
  "repository": "itzkaushik/nikia",
  "build": {
    "appId": "com.nikia.app",
    "productName": "Nikia",
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "https://cine-sync.cine-sync.workers.dev/updates"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.obf.js"
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "mac": {
      "target": "dmg",
      "icon": null
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12",
    "opensubtitles-api": "^5.1.2",
    "webtorrent": "^3.0.16"
  }
}
