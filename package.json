{
  "name": "nikia",
  "version": "1.0.7",
  "description": "Nikia — Watch Together Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "node obfuscate.js && electron-builder --win -p always && node restore.js",
    "build:mac": "node obfuscate.js && electron-builder --mac -p always && node restore.js",
    "build:android": "npx esbuild src/android.js --bundle --outfile=android.js --format=iife && node copy_for_android.js && npx cap sync && cd android && ./gradlew assembleRelease",
    "build": "node obfuscate.js && electron-builder --win --mac -p always && node restore.js"
  },
  "author": "itzkaushik",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "cheerio": "^1.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^5.5.0"
  },
  "overrides": {
    "ip": "^2.0.1",
    "tar": "^6.2.1"
  },
  "repository": "itzkaushik/nikia",
  "build": {
    "appId": "com.nikia.app",
    "productName": "Nikia",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://cine-sync.cine-sync.workers.dev/updates"
      },
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.obf.js"
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": null
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/device": "^8.0.3",
    "@supabase/supabase-js": "^2.110.8",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12",
    "opensubtitles-api": "^5.1.2",
    "webtorrent": "^3.0.16"
  }
}
