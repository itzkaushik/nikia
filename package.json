{
  "name": "nikia",
  "version": "1.0.1",
  "description": "Nikia — Watch Together Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win -p always",
    "build:mac": "electron-builder --mac -p always",
    "build": "electron-builder --win --mac -p always"
  },
  "author": "itzkaushik",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "repository": "itzkaushik/nikia",
  "build": {
    "appId": "com.nikia.app",
    "productName": "Nikia",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "itzkaushik",
      "repo": "nikia"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "mac": {
      "target": "dmg",
      "icon": null
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12",
    "opensubtitles-api": "^5.1.2",
    "webtorrent": "^3.0.16"
  }
}
